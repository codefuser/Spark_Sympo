datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}

model Event {
  id                        String         @id @default(uuid())
  slug                      String         @unique
  title                     String
  category                  String         // TECHNICAL, NON_TECHNICAL, WORKSHOP
  shortDesc                 String
  fullDesc                  String
  rules                     String
  eligibility               String
  teamSize                  String
  minMembers                Int            @default(1)
  maxMembers                Int            @default(5)
  maxTeams                  Int            @default(100)
  rounds                    String
  date                      String
  time                      String
  venue                     String
  coordinatorName           String
  coordinatorPhone          String
  status                    String         @default("OPEN") // OPEN, CLOSED, UPCOMING
  image                     String?
  technicalRegistrations    Registration[] @relation("TechnicalEvent")
  nonTechnicalRegistrations Registration[] @relation("NonTechnicalEvent")
  createdAt                 DateTime       @default(now())
}

model Registration {
  id                  String        @id @default(uuid())
  registrationCode    String        @unique
  registrationType    String        @default("online") // online, offline
  technicalEventId    String
  technicalEvent      Event         @relation("TechnicalEvent", fields: [technicalEventId], references: [id])
  nonTechnicalEventId String
  nonTechnicalEvent   Event         @relation("NonTechnicalEvent", fields: [nonTechnicalEventId], references: [id])
  teamName            String?
  status              String        @default("CONFIRMED")
  paymentStatus       String        @default("UNPAID")
  transactionId       String?
  paymentProofUrl     String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  participants        Participant[]
}

model Participant {
  id             String       @id @default(uuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fullName       String
  email          String
  phone          String
  college        String
  department     String?
  foodPreference String       @default("Veg") // Veg, Non-Veg
  isTeamLeader   Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([email])
}

model QuizSettings {
  id              String   @id @default(uuid())
  quizTitle       String   @default("SPARKTRON 2K26 Technical Quiz")
  startTime       DateTime
  endTime         DateTime
  isActive        Boolean  @default(true)
  durationMinutes Int      @default(30)
  createdAt       DateTime @default(now())
}

model Coordinator {
  id          String  @id @default(uuid())
  name        String
  role        String // FACULTY or STUDENT
  designation String?
  department  String  @default("ECE")
  phone       String
  email       String
  avatar      String?
  eventName   String?
}

model Sponsor {
  id         String  @id @default(uuid())
  name       String
  tier       String // PLATINUM, GOLD, SILVER, MEDIA
  logoUrl    String?
  websiteUrl String?
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
  status    String   @default("UNREAD")
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  priority  String   @default("NORMAL") // HIGH, NORMAL
  date      DateTime @default(now())
}

model WhatsappMessage {
  id                String    @id @default(uuid())
  registrationId    String?
  recipientName     String
  recipientPhone    String
  messageType       String    @default("CUSTOM")
  messageContent    String
  status            String    @default("Pending") // Pending, Sending, Sent, Delivered, Read, Failed
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
}

model WhatsappSetting {
  id               String   @id @default("default_settings")
  isEnabled        Boolean  @default(true)
  venueName        String   @default("St. Joseph's Institute of Technology")
  venueAddress     String   @default("ECE Block Auditorium & Labs, College Campus, OMR, Chennai - 600119")
  mapLink          String   @default("https://maps.google.com/?q=St.+Joseph's+Institute+of+Technology")
  latitude         Float?
  longitude        Float?
  quizLink         String   @default("https://sparktron-quiz.vercel.app")
  pptUploadLink    String   @default("https://forms.gle/sparktron2k26ppt")
  projectLink      String   @default("https://forms.gle/sparktron2k26project")
  customEventLinks String   @default("{}")
  updatedAt        DateTime @default(now())
}

